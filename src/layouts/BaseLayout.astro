---
import "../styles/global.css";
import "../styles/components.css";
import { SITE_URL } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = "DichThat — Quick Translate for macOS",
  description = "Fast English–Vietnamese translation, right where you’re reading on macOS.",
  path = "/",
} = Astro.props;

const canonical = new URL(path, SITE_URL);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f7" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/app-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DichThat" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og-image.png", SITE_URL)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="DichThat — Quick Translate for macOS" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og-image.png", SITE_URL)} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem("dichthat-theme");
        } catch {}
        const preference = saved === "light" || saved === "dark" || saved === "system"
          ? saved
          : "system";
        const theme = preference === "system"
          ? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
          : preference;
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      import { initializeAppearance } from "../scripts/appearance";
      import { initializeLocale } from "../scripts/locale";
      import { initializeRevealMotion } from "../scripts/reveal";

      initializeLocale();
      initializeAppearance();
      initializeRevealMotion();
    </script>
  </body>
</html>
