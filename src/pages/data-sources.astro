---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";

const WORDNET_SOURCE = "https://en-word.net/";
const WORDNET_LICENSE = "https://creativecommons.org/licenses/by/4.0/";
const CMU_SOURCE = "https://github.com/cmusphinx/cmudict";
const CMU_LICENSE = "https://github.com/hgthaii/dichthat/blob/master/Resources/ThirdPartyNotices/CMUdict-LICENSE.txt";
---

<BaseLayout
  title="Data Sources — DichThat"
  description="The on-device frameworks and bundled language data used by DichThat."
  path="/data-sources/"
>
  <main class="info-page container">
    <a class="info-back" href="/" aria-label="Back to DichThat">
      <span aria-hidden="true">←</span>
      <span data-i18n="dataSources.back">Back to DichThat</span>
    </a>

    <header class="info-header">
      <p class="section-eyebrow" data-i18n="dataSources.eyebrow">DichThat</p>
      <h1 data-i18n="dataSources.title">Data Sources</h1>
      <p class="info-intro" data-i18n="dataSources.intro">
        DichThat combines macOS system frameworks with bundled offline language data.
      </p>
      <small data-i18n="dataSources.updated">Last updated: August 28, 2026</small>
    </header>

    <div class="info-content">
      <section>
        <h2 data-i18n="dataSources.appleTitle">Apple Translation</h2>
        <p data-i18n="dataSources.appleBody">
          English–Vietnamese translation is handled on your Mac. Language models are supplied and managed by macOS.
        </p>
      </section>

      <section>
        <h2 data-i18n="dataSources.speechTitle">macOS system voices</h2>
        <p data-i18n="dataSources.speechBody">
          Pronunciation playback uses AVSpeechSynthesizer and the voices installed on your Mac.
        </p>
      </section>

      <section>
        <h2>Open English WordNet 2025</h2>
        <p data-i18n="dataSources.wordnetBody">
          Provides English meanings, examples, parts of speech, and synonyms. Derived from Princeton WordNet 3.1 and licensed under CC BY 4.0.
        </p>
        <div class="info-links">
          <a href={WORDNET_SOURCE} target="_blank" rel="noreferrer"><span data-i18n="dataSources.sourceLink">Source</span> ↗</a>
          <a href={WORDNET_LICENSE} target="_blank" rel="noreferrer"><span data-i18n="dataSources.licenseLink">License</span> ↗</a>
        </div>
      </section>

      <section>
        <h2>CMU Pronouncing Dictionary</h2>
        <p data-i18n="dataSources.cmuBody">
          Provides US English pronunciation data used to generate IPA. DichThat bundles pinned revision 74790861f652b15e4ac49015a90074ad62a27690.
        </p>
        <div class="info-links">
          <a href={CMU_SOURCE} target="_blank" rel="noreferrer"><span data-i18n="dataSources.sourceLink">Source</span> ↗</a>
          <a href={CMU_LICENSE} target="_blank" rel="noreferrer"><span data-i18n="dataSources.licenseLink">License</span> ↗</a>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
