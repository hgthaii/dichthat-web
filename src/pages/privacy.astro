---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import { GITHUB_ISSUES_URL } from "../config/site";
import { en } from "../i18n/en";

const sections = [
  ["privacy.selectedTitle", en.privacy.selectedTitle, "privacy.selectedBody", en.privacy.selectedBody],
  ["privacy.servicesTitle", en.privacy.servicesTitle, "privacy.servicesBody", en.privacy.servicesBody],
  ["privacy.dictionaryTitle", en.privacy.dictionaryTitle, "privacy.dictionaryBody", en.privacy.dictionaryBody],
  ["privacy.storageTitle", en.privacy.storageTitle, "privacy.storageBody", en.privacy.storageBody],
  ["privacy.thirdPartyTitle", en.privacy.thirdPartyTitle, "privacy.thirdPartyBody", en.privacy.thirdPartyBody],
  ["privacy.analyticsTitle", en.privacy.analyticsTitle, "privacy.analyticsBody", en.privacy.analyticsBody],
] as const;
---

<BaseLayout
  title="Privacy — DichThat"
  description="How DichThat processes selected text on your Mac, stores preferences, and connects to update services."
  path="/privacy/"
>
  <main class="info-page container">
    <a class="info-back" href="/" aria-label="Back to DichThat">
      <span aria-hidden="true">←</span>
      <span data-i18n="privacy.back">Back to DichThat</span>
    </a>

    <header class="info-header">
      <p class="section-eyebrow" data-i18n="privacy.eyebrow">DichThat</p>
      <h1 data-i18n="privacy.title">Privacy</h1>
      <p class="info-intro" data-i18n="privacy.intro">
        DichThat is designed to translate the text you choose without building a history of what you read or write.
      </p>
      <small data-i18n="privacy.updated">Last updated: August 28, 2026</small>
    </header>

    <div class="info-content">
      {sections.map(([titleKey, title, bodyKey, body]) => (
        <section>
          <h2 data-i18n={titleKey}>{title}</h2>
          <p data-i18n={bodyKey}>{body}</p>
        </section>
      ))}

      <section>
        <h2 data-i18n="privacy.contactTitle">Questions</h2>
        <p>
          <span data-i18n="privacy.contactBody">For privacy questions or bug reports, open an issue on GitHub.</span>
          <a href={GITHUB_ISSUES_URL}> GitHub ↗</a>
        </p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
