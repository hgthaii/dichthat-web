---
import { DOWNLOAD_URL, GITHUB_URL } from "../config/site";
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <img class="app-icon" src="/app-icon.png" width="112" height="112" alt="DichThat app icon" />
    <p class="product" data-i18n="hero.product">DichThat</p>
    <h1 id="hero-title" data-i18n="hero.tagline">Translate. Stay in flow.</h1>
    <p class="description" data-i18n="hero.description">
      Fast English–Vietnamese translation, right where you’re reading on macOS.
    </p>
    <div class="actions">
      <a class="primary-button" href={DOWNLOAD_URL} data-i18n="hero.download">Download for macOS</a>
      <a class="text-link" href={GITHUB_URL} data-i18n="hero.github" target="_blank">GitHub</a>
      <span class="external" aria-hidden="true">↗</span>
    </div>
    <p class="requirement" data-i18n="hero.requirement">Requires macOS 26 or later</p>
  </div>
</section>

<style>
  .hero {
    min-height: 85vh;
    display: grid;
    place-items: center;
    padding-block: clamp(5rem, 10vh, 8rem);
  }

  .hero-copy {
    width: 100%;
    max-width: var(--container);
    text-align: center;
  }

  .app-icon {
    width: 104px;
    height: 104px;
    margin: 0 auto 1.5rem;
    border-radius: 23%;
    box-shadow: 0 12px 36px rgb(0 0 0 / 13%);
  }

  .product {
    margin: 0 0 0.75rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
    font-weight: 600;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 5.8vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
    white-space: nowrap;
  }

  .description {
    max-width: 570px;
    margin: 1.65rem auto 0;
    color: var(--text-secondary);
    font-size: clamp(1.08rem, 2vw, 1.35rem);
    line-height: 1.55;
    letter-spacing: -0.018em;
  }

  .actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.45rem;
    margin-top: 2rem;
  }

  .actions .primary-button {
    margin-right: 0.85rem;
  }

  .external {
    color: var(--text-secondary);
  }

  .requirement {
    margin: 0.9rem 0 0;
  }

  @media (max-width: 560px) {
    .hero {
      min-height: auto;
      padding-block: 5.5rem 4rem;
    }

    .app-icon {
      width: 88px;
      height: 88px;
    }

    h1 {
      font-size: clamp(1.75rem, 7.6vw, 2.25rem);
      letter-spacing: -0.045em;
    }

    .actions {
      display: grid;
      grid-template-columns: 1fr auto;
      max-width: 320px;
      margin-inline: auto;
    }

    .actions .primary-button {
      grid-column: 1 / -1;
      width: 100%;
      margin: 0 0 0.6rem;
    }
  }
</style>
