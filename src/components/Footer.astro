---
import AppearanceSwitcher from "./AppearanceSwitcher.astro";
import LocaleSwitcher from "./LocaleSwitcher.astro";
import { BUY_ME_A_COFFEE_URL, GITHUB_URL } from "../config/site";

const links = [
  { href: GITHUB_URL, key: "footer.github", label: "GitHub", external: true },
  { href: "/privacy/", key: "footer.privacy", label: "Privacy", external: false },
  { href: "/data-sources/", key: "footer.dataSources", label: "Data Sources", external: false },
  { href: BUY_ME_A_COFFEE_URL, key: "footer.support", label: "Buy me a coffee", external: true },
] as const;

const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner container">
    <div class="identity">
      <strong data-i18n="footer.product">DichThat</strong>
      <small data-i18n="footer.copyright">© {year} hgthaii</small>
    </div>

    <nav aria-label="Footer">
      {links.map((link, index) => (
        <>
          {index > 0 && <span aria-hidden="true">·</span>}
          <a
            class:list={{ "support-link": link.key === "footer.support" }}
            href={link.href}
            data-i18n={link.key}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noreferrer" : undefined}
          >
            {link.label}
          </a>
        </>
      ))}
    </nav>

    <div class="preferences">
      <LocaleSwitcher />
      <AppearanceSwitcher />
    </div>
  </div>
</footer>

<style>
  footer {
    padding-block: 2.25rem;
    border-top: 1px solid var(--divider);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
  }

  .identity {
    display: grid;
    gap: 0.4rem;
  }

  .identity strong {
    font-size: 0.88rem;
  }

  .identity small {
    color: var(--text-tertiary);
    font-size: 0.7rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem;
    color: var(--text-secondary);
    font-size: 0.8rem;
  }

  nav a {
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text-primary);
  }

  .support-link {
    color: var(--text-primary);
    /* font-weight: 600; */
  }

  .preferences {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1rem;
  }

  @media (max-width: 760px) {
    footer {
      padding-block: 2.75rem;
    }

    .footer-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      text-align: center;
    }

    .identity {
      gap: 0.3rem;
    }

    .preferences {
      justify-content: center;
      gap: 0.75rem;
    }
  }
</style>
